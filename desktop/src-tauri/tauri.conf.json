{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unscroll",
  "version": "0.1.0",
  "identifier": "org.unscroll.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Unscroll",
        "width": 1050,
        "minWidth": 800,
        "height": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": [],
    "resources": {
      "resources/adb/*": "adb/",
      "resources/launcher/*": "launcher/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Unscroll"
      }
    }
  }
}
